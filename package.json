{
  "name": "prosemirror-freeze-plugin",
  "version": "0.3.0",
  "description": "ProseMirror plugin that introduces non-deletable, non-editable frozen text sections with markdown round-trip support.",
  "keywords": [
    "editor",
    "freeze",
    "markdown",
    "plugin",
    "prosemirror",
    "readonly"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./tiptap": {
      "types": "./dist/tiptap.d.ts",
      "import": "./dist/tiptap.js"
    }
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "VITEST_BROWSER=1 vitest run",
    "test:all": "pnpm test && pnpm test:e2e",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:all",
    "prepack": "pnpm clean && pnpm build",
    "pack:tarball": "pnpm pack",
    "example:dev": "vite --config example/vite.config.ts",
    "example:build": "vite build --config example/vite.config.ts"
  },
  "devDependencies": {
    "@tiptap/core": "^3.23.1",
    "@tiptap/extension-document": "^3.23.1",
    "@tiptap/extension-paragraph": "^3.23.1",
    "@tiptap/extension-text": "^3.23.1",
    "@tiptap/pm": "^3.23.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "@typescript/native-preview": "7.0.0-dev.20251101.1",
    "@vitest/browser": "^2.1.8",
    "happy-dom": "^15.11.7",
    "markdown-it": "^14.1.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^0.15.5",
    "playwright": "^1.49.1",
    "prosemirror-commands": "^1.6.2",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-markdown": "^1.13.1",
    "prosemirror-model": "^1.24.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-test-builder": "^1.1.1",
    "prosemirror-view": "^1.37.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "@tiptap/core": "^2.0.0 || ^3.0.0",
    "markdown-it": "^14.0.0",
    "prosemirror-commands": "^1.5.0",
    "prosemirror-keymap": "^1.2.0",
    "prosemirror-markdown": "^1.13.0",
    "prosemirror-model": "^1.22.0",
    "prosemirror-state": "^1.4.0",
    "prosemirror-view": "^1.34.0"
  },
  "peerDependenciesMeta": {
    "markdown-it": {
      "optional": true
    },
    "prosemirror-markdown": {
      "optional": true
    },
    "@tiptap/core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0"
}
